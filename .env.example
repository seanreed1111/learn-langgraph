# Optional. Without a key, every lesson runs offline with a scripted fake model.
ANTHROPIC_API_KEY=

# The default model is defined once, in lessons/common.py (DEFAULT_MODEL = anthropic:claude-sonnet-5-5).
# Override with any init_chat_model string:
#   LG_MODEL=anthropic:claude-opus-5-5      # most capable general model
#   LG_MODEL=anthropic:claude-haiku-5-5     # fastest / cheapest
#   LG_MODEL=anthropic:claude-fable-5-2     # top tier, long-horizon agentic work
# Other providers need BOTH their key and an explicit LG_MODEL (the default is an Anthropic model):
#   OPENAI_API_KEY=
#   LG_MODEL=openai:<model-id>
# LG_TEMPERATURE=0     # opt in to a sampling temperature (left at the provider default otherwise)

# Real embeddings for the RAG apps (Anthropic has no embeddings API). Needs: pip install -e ".[openai]"
# OPENAI_API_KEY=
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# Optional tracing (highly recommended once you use a real model):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
